# ==========================================
# بيئة تشغيل وإنتاج تطبيق صحبة شات على Railway
# ==========================================

# المنفذ وبيئة التشغيل
NODE_ENV=production
PORT=3000

# روابط السيرفر والتطبيق
VITE_API_SERVER_URL=https://web-production-d1043.up.railway.app
APP_URL=https://web-production-d1043.up.railway.app

# مفاتيح التحقق من الروبوتات Cloudflare Turnstile
VITE_CLOUDFLARE_TURNSTILE_SITE_KEY=1x00000000000000000000AA
CLOUDFLARE_TURNSTILE_SECRET_KEY=1x0000000000000000000000000000000AA

# مفتاح Gemini (يعمل بدونه بالفلترة المدمجة الذكية)
GEMINI_API_KEY=""

# خوادم الاتصال الصوتي والمرئي WebRTC
TURN_SERVER_URLS=stun:stun.l.google.com:19302,stun:stun1.l.google.com:19302
TURN_SHARED_SECRET=sohba-chat-turn-shared-secret-key-2026

# رموز إدارة المالك
OWNER_BOOTSTRAP_TOKEN=sohba-chat-owner-bootstrap-secret-token-2026-secure
OWNER_RECOVERY_TOKEN=sohba-chat-owner-recovery-secret-token-2026-secure
