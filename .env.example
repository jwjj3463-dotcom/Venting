# رابط السيرفر الخلفي لتطبيق الأندرويد (Capacitor APK)
# اتركه فارغاً أثناء التطوير المحلي، وعند بناء ملف APK ضع رابط استضافتك (مثلاً https://api.yourdomain.com)
# أو عنوان الـ IP المحلي لجهاز الكمبيوتر على نفس شبكة الواي فاي (مثلاً http://192.168.1.15:3000)
VITE_API_SERVER_URL=""

# مفتاح Turnstile العام للتطبيق. يجب إعداد السر المقابل على الخادم قبل نشر تسجيل الحساب.
VITE_CLOUDFLARE_TURNSTILE_SITE_KEY=""

# منفذ تشغيل السيرفر المستقل
PORT="3000"

# سر Cloudflare Turnstile للخادم فقط؛ لا تضعه في متغيرات VITE أو تطبيق Android.
CLOUDFLARE_TURNSTILE_SECRET_KEY=""

# اختياري: مفتاح Gemini لتحسين الفلترة الدلالية بالذكاء الاصطناعي (يعمل السيرفر بدونه أيضاً بمحرك الفلترة المحلي المدمج)
GEMINI_API_KEY=""
APP_URL=""

# WebRTC calls: set these on the backend only. TURN_SERVER_URLS accepts
# comma-separated TURN/TURNS URLs; TURN_SHARED_SECRET is at least 32 bytes
# and is used to issue
# short-lived credentials and must never be exposed as a VITE_* variable.
TURN_SERVER_URLS=""
TURN_SHARED_SECRET=""

# رمز عشوائي مؤقت لتهيئة المالك الأول فقط (32 بايت على الأقل).
# أنشئه مثلاً عبر: openssl rand -hex 32
# احذفه من إعدادات الاستضافة بعد المطالبة بالمالك الأول.
OWNER_BOOTSTRAP_TOKEN=""

# رمز مؤقت لمرة واحدة لإضافة حساب مالك بديل مع إبقاء المالك الحالي وبياناته.
# اضبطه في بيئة تشغيل الخادم فقط بعد نشر دعم /api/admin/owner-recovery.
# أنشئه مثلاً عبر: openssl rand -hex 32
# احذفه من إعدادات الاستضافة بعد نجاح مطالبة الحساب الجديد بالمالك.
OWNER_RECOVERY_TOKEN=""
