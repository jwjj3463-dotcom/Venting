# رابط السيرفر الخلفي لتطبيق الأندرويد (Capacitor APK)
# اتركه فارغاً أثناء التطوير المحلي، وعند بناء ملف APK ضع رابط استضافتك (مثلاً https://api.yourdomain.com)
# أو عنوان الـ IP المحلي لجهاز الكمبيوتر على نفس شبكة الواي فاي (مثلاً http://192.168.1.15:3000)
VITE_API_SERVER_URL=""

# منفذ تشغيل السيرفر المستقل
PORT="3000"

# اختياري: مفتاح Gemini لتحسين الفلترة الدلالية بالذكاء الاصطناعي (يعمل السيرفر بدونه أيضاً بمحرك الفلترة المحلي المدمج)
GEMINI_API_KEY=""
APP_URL=""

# مفتاح الدخول والتحقق الإداري لطاقم الإشراف والمالك
ADMIN_SECRET_KEY="FadfadahAdmin2026!"
